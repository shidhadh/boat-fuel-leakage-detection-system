
#define BLYNK_TEMPLATE_ID "YOUR_TEMPLATE_ID"
#define BLYNK_TEMPLATE_NAME "Boat Fuel Leakage Detection"
#define BLYNK_AUTH_TOKEN "YOUR_BLYNK_AUTH_TOKEN"

#include <WiFi.h>
#include <BlynkSimpleEsp32.h>

// WiFi details
char ssid[] = "YOUR_WIFI_NAME";
char pass[] = "YOUR_WIFI_PASSWORD";

// Pin definitions
const int mq2Pin = 34;
const int relayPin = 26;
const int buzzerPin = 27;

// Gas detection threshold
const int threshold = 1500;

// Blynk timer
BlynkTimer timer;

// Prevent repeated notifications
bool leakageDetected = false;


// --------------------------------------------------
// Check MQ-2 Gas Sensor
// --------------------------------------------------
void checkGas()
{
  int gasValue = analogRead(mq2Pin);

  Serial.print("Gas Level: ");
  Serial.println(gasValue);

  // Send gas value to Blynk
  Blynk.virtualWrite(V1, gasValue);

  // -----------------------------------------------
  // FUEL LEAKAGE DETECTED
  // -----------------------------------------------
  if (gasValue >= threshold && leakageDetected == false)
  {
    leakageDetected = true;

    // Buzzer ON
    digitalWrite(buzzerPin, HIGH);

    // Relay ON
    // Fuel pump OFF
    digitalWrite(relayPin, HIGH);

    // Send message/event through Blynk
    Blynk.logEvent(
      "fuel_leakage",
      "⚠️ FUEL LEAKAGE DETECTED! Fuel pump has been stopped."
    );

    // Display status
    Blynk.virtualWrite(V2, "FUEL LEAKAGE DETECTED");

    Serial.println("================================");
    Serial.println("⚠️ FUEL LEAKAGE DETECTED!");
    Serial.println("Buzzer      : ON");
    Serial.println("Fuel Pump   : OFF");
    Serial.println("Blynk Alert : SENT");
    Serial.println("================================");
  }

  // -----------------------------------------------
  // GAS LEVEL RETURNED TO NORMAL
  // -----------------------------------------------
  if (gasValue < threshold && leakageDetected == true)
  {
    leakageDetected = false;

    // Buzzer OFF
    digitalWrite(buzzerPin, LOW);

    // Relay OFF
    // Fuel pump ON
    digitalWrite(relayPin, LOW);

    // Update Blynk status
    Blynk.virtualWrite(V2, "NORMAL");

    Serial.println("Gas level returned to normal.");
    Serial.println("Fuel Pump: ON");
    Serial.println("Buzzer: OFF");
  }
}


// --------------------------------------------------
// SETUP
// --------------------------------------------------
void setup()
{
  Serial.begin(115200);

  // Pin configuration
  pinMode(mq2Pin, INPUT);
  pinMode(relayPin, OUTPUT);
  pinMode(buzzerPin, OUTPUT);

  // Initial state
  digitalWrite(relayPin, LOW);
  digitalWrite(buzzerPin, LOW);

  Serial.println();
  Serial.println("======================================");
  Serial.println(" Boat Fuel Leakage Detection System");
  Serial.println("======================================");

  // MQ-2 warm-up
  Serial.println("MQ-2 Sensor Warming Up...");

  for (int i = 20; i > 0; i--)
  {
    Serial.print("Warm-up: ");
    Serial.print(i);
    Serial.println(" seconds");

    delay(1000);
  }

  Serial.println("MQ-2 Warm-up Completed.");

  // Connect ESP32 to Blynk
  Blynk.begin(BLYNK_AUTH_TOKEN, ssid, pass);

  // Check gas every 500 ms
  timer.setInterval(500L, checkGas);
}


// --------------------------------------------------
// LOOP
// --------------------------------------------------
void loop()
{
  Blynk.run();
  timer.run();
}
